# =============================================================================
# MakeInc.config -- architecture and kernel-configuration resolution
# =============================================================================
#
# The build has two independent dimensions:
#
#   ARCH_CONFIGS    which architecture(s) to build   (default: aarch64)
#   KERNEL_CONFIGS  which kernel configuration(s)     (default: DEVELOPMENT)
#
# and three output roots that can be relocated independently:
#
#   OBJROOT  intermediate objects and dependency files
#   SYMROOT  linked kernels and debug/symbol artifacts
#   DSTROOT  staged installation output (never the host system)
#
# This file is additive: it defines the vocabulary and resolves the defaults to
# NXU's historical behaviour. Requires BUILD_ROOT to be defined first.

# --- Architecture configurations --------------------------------------------

SUPPORTED_ARCHS := aarch64 i386 x86_64

# The historical default build is aarch64 (`make all`).
ARCH_CONFIGS ?= aarch64

# `arm64` is accepted as a synonym for `aarch64`.
ARCH_CONFIGS := $(patsubst arm64,aarch64,$(ARCH_CONFIGS))

$(foreach a,$(ARCH_CONFIGS),\
  $(if $(filter $(a),$(SUPPORTED_ARCHS)),,\
    $(error Unknown ARCH_CONFIGS '$(a)' -- supported: $(SUPPORTED_ARCHS))))

# --- Kernel configurations ---------------------------------------------------

SUPPORTED_CONFIGS := DEBUG DEVELOPMENT RELEASE

KERNEL_CONFIGS ?= DEVELOPMENT

$(foreach c,$(KERNEL_CONFIGS),\
  $(if $(filter $(c),$(SUPPORTED_CONFIGS)),,\
    $(error Unknown KERNEL_CONFIGS '$(c)' -- supported: $(SUPPORTED_CONFIGS))))

# Configuration-specific compiler flags (the optimisation/debug axis only; the
# common freestanding/warning/dependency flags are architecture-independent and
# live with the compile rules). DEVELOPMENT reproduces NXU's historical build
# exactly (-O2 -g, no extra defines) so a bare `make` is unchanged. DEBUG and
# RELEASE additionally define DEBUG / NDEBUG for code that chooses to gate on
# them (no source does yet, so today they differ only in -O and -g).
CONFIG_CFLAGS_DEBUG       := -O0 -g -DDEBUG
CONFIG_CFLAGS_DEVELOPMENT := -O2 -g
CONFIG_CFLAGS_RELEASE     := -O2 -DNDEBUG

# --- Build output roots ------------------------------------------------------
#
# Default to BUILD_ROOT so existing paths are unchanged: a port keeps building
# into $(OBJROOT)/<its historical subdir> (see ARCH_BUILDDIR_* in
# MakeInc.arch). Set OBJROOT/SYMROOT/DSTROOT explicitly to relocate.

OBJROOT ?= $(BUILD_ROOT)
SYMROOT ?= $(BUILD_ROOT)
DSTROOT ?= $(BUILD_ROOT)/dst
